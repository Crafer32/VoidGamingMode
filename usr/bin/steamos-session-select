#!/bin/sh
# SteamOS-like session switching for Void Linux (runit + SDDM, no systemd).

set_session() {   # $1 = plasma | gamescope-steam
    printf '[Autologin]\nRelogin=true\nSession=%s\nUser=deck\n' "$1" > /etc/sddm.conf.d/autologin.conf
}

case "$1" in
    boot) [ -e /run/steamos-session-boot ] && exit 0
          : > /run/steamos-session-boot; set_session "${2:-plasma}"; exit 0 ;;
    desktop|plasma*)  S=plasma ;;
    gaming|gamescope) S=gamescope-steam ;;
    *) echo "usage: $0 desktop|gaming|boot [SESSION]" >&2; exit 1 ;;
esac

[ "$(id -u)" -eq 0 ] || exec doas -n "$0" "$1"
set_session "$S"
# Kill what is left of the session we leave (its cgroup), detached from doas
setsid -f sh -c "sleep 1; echo 1 > /sys/fs/cgroup/$(loginctl show-seat seat0 -p ActiveSession --value)/cgroup.kill"
sv restart sddm
